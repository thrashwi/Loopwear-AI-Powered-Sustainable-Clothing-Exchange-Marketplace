{
  "name": "loopwear-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Loopwear - AI-Powered Sustainable Clothing Exchange Marketplace",
  "scripts": {
    "server": "npm run start --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "test": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
