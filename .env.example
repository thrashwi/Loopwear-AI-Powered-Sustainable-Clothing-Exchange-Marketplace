# Root Environment Example for Loopwear
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=loopwear_super_secret_jwt_key_2026

# Optional: Persistent database connection (MongoDB Atlas for cloud deployment)
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/loopwear?retryWrites=true&w=majority

# Optional: Google Gemini API (leave blank to run in smart zero-key demo fallback mode)
# GEMINI_API_KEY=your_gemini_api_key_here
